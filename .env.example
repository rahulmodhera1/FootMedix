# Contact form (Web3Forms) — lets the website send messages straight to the
# clinic inbox without opening the visitor's email app.
#
# How to get the key (free, ~30 seconds):
#   1. Go to https://web3forms.com
#   2. Enter footmedix1@gmail.com as the email to receive submissions
#   3. Copy the Access Key they show / email you
#   4. Paste it below, and add the same variable in Vercel:
#      Project → Settings → Environment Variables
#
# Until this is set, the form gracefully falls back to opening the email app.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
